import java.util.Scanner;

public class HW1A {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);


        int a = scanner.nextInt();


        int b = scanner.nextInt();


        int lcf = findLCF(a, b);
        System.out.println( lcf);
    }


    public static int findLCF(int a, int b) {

        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
